{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jarvis.local/schemas/common.schema.json",
  "title": "JARVIS Common Definitions",
  "description": "Gemeinsame Basistypen fuer alle JARVIS-Datenvertraege. Version 1.0.0.",
  "$defs": {
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "description": "Semantische Version des Datenvertrags, mit dem der Datensatz erzeugt wurde."
    },
    "context_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{2,31}$",
      "description": "Eindeutige Kontextkennung, z. B. privat oder arbeitgeber_visolva."
    },
    "ulid": {
      "type": "string",
      "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "prefixed_id": {
      "type": "string",
      "pattern": "^[a-z]{3}_[0-9A-HJKMNP-TV-Z]{26}$",
      "description": "Globale Objekt-ID: dreistelliges Praefix, Unterstrich, ULID."
    },
    "event_id": { "type": "string", "pattern": "^evt_[0-9A-HJKMNP-TV-Z]{26}$" },
    "task_id": { "type": "string", "pattern": "^tsk_[0-9A-HJKMNP-TV-Z]{26}$" },
    "action_id": { "type": "string", "pattern": "^act_[0-9A-HJKMNP-TV-Z]{26}$" },
    "approval_id": { "type": "string", "pattern": "^apr_[0-9A-HJKMNP-TV-Z]{26}$" },
    "evidence_id": { "type": "string", "pattern": "^evd_[0-9A-HJKMNP-TV-Z]{26}$" },
    "error_id": { "type": "string", "pattern": "^err_[0-9A-HJKMNP-TV-Z]{26}$" },
    "timestamp_utc": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$",
      "description": "ISO-8601 Zeitstempel, immer in UTC gespeichert. Anzeige erfolgt in Europe/Zurich."
    },
    "object_type": {
      "type": "string",
      "enum": [
        "document", "email", "conversation", "person", "organization",
        "project", "case", "task", "action", "calendar_event",
        "decision", "memory_entry", "knowledge_item", "file",
        "approval", "evidence", "event"
      ]
    },
    "actor": {
      "type": "string",
      "enum": ["jarvis", "rolf", "mitarbeiter", "externer"],
      "description": "Wer eine AUFGABE fachlich verantwortet. Technische Aktionen werden ausschliesslich vom registrierten Executor ausgefuehrt, siehe action.schema.json."
    },
    "risk_class": {
      "type": "string",
      "enum": ["A", "B", "C"],
      "description": "A: automatisch. B: automatisch mit Information. C: Freigabe vor Ausfuehrung."
    },
    "priority": {
      "type": "string",
      "enum": ["low", "normal", "high", "critical"]
    },
    "reversibility": {
      "type": "string",
      "enum": ["reversible", "compensable", "irreversible"]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "idempotency_key": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "SHA-256 Hexdigest ueber die normalisierte Idempotenzbasis."
    },
    "trace": {
      "type": "object",
      "description": "Technische Korrelationsdaten. Enthalten niemals fachliche Inhalte.",
      "properties": {
        "trace_id": { "type": "string", "minLength": 8, "maxLength": 64 },
        "correlation_id": { "type": "string", "minLength": 8, "maxLength": 64 },
        "causation_id": { "type": "string", "minLength": 8, "maxLength": 64 },
        "workflow_name": { "type": "string" },
        "workflow_version": { "type": "string" },
        "run_id": { "type": "string" }
      },
      "required": ["trace_id"],
      "additionalProperties": false
    },
    "producer": {
      "type": "object",
      "description": "Erzeuger eines Datensatzes.",
      "properties": {
        "producer_type": { "type": "string", "enum": ["workflow", "agent", "human", "adapter", "import"] },
        "producer_id": { "type": "string" },
        "producer_version": { "type": "string" }
      },
      "required": ["producer_type", "producer_id"],
      "additionalProperties": false
    },
    "text_evidence": {
      "type": "object",
      "description": "Feldweiser Textbeleg mit Konfidenz. Wird ab Phase 1 genutzt.",
      "properties": {
        "field": { "type": "string" },
        "value": {},
        "confidence": { "$ref": "#/$defs/confidence" },
        "snippet": { "type": "string", "maxLength": 500 },
        "locator": { "type": "string", "description": "z. B. page=2;bbox=..." }
      },
      "required": ["field", "confidence"],
      "additionalProperties": false
    }
  }
}
