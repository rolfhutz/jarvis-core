      "retry_policy": {
        "retryable_error_classes": ["transient_network", "rate_limited", "timeout"],
        "max_attempts": 3,
        "backoff": "exponential_1m_factor5_jitter"
      },
      "timeout_seconds": 60,
      "rate_limit": null,
      "dry_run_supported": true,
      "status": "draft",
      "owner": "rolf"
    },
