      "tool_id": "storage_gdrive.move_file",
      "version": "1.0.0",
      "display_name": "Datei ablegen",
      "purpose": "Datei in den kontextbezogenen Zielordner verschieben und umbenennen.",
      "adapter_id": "storage_gdrive",
      "operation": "write",
      "allowed_contexts": ["privat"],
