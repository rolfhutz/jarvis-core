{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jarvis.local/schemas/tools/report_internal.write_daily_report.output.json",
  "title": "Ausgabe: Tagesbericht schreiben",
  "description": "Ergebnis der Berichtsablage. Version 1.0.0, Phase 1.",
  "type": "object",
  "properties": {
    "report_external_id": {
      "type": "string"
    },
    "final_path": {
      "type": "string",
      "maxLength": 500
    },
    "final_filename": {
      "type": "string",
      "maxLength": 200
    },
    "entry_count": {
      "type": "integer",
      "minimum": 0
    },
    "created_at": {
      "$ref": "https://jarvis.local/schemas/common.schema.json#/$defs/timestamp_utc"
    },
    "provider_status": {
      "type": "integer"
    }
  },
  "required": [
    "report_external_id",
    "final_path",
    "final_filename",
    "entry_count",
    "created_at",
    "provider_status"
  ],
  "additionalProperties": false
}
