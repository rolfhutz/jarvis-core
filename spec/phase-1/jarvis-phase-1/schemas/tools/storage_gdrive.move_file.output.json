{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jarvis.local/schemas/tools/storage_gdrive.move_file.output.json",
  "title": "Ausgabe: Datei ablegen",
  "description": "Ergebnis des Verschiebens. Grundlage des Readback-Nachweises. Version 1.0.0, Phase 1.",
  "type": "object",
  "properties": {
    "file_external_id": {
      "type": "string"
    },
    "final_path": {
      "type": "string",
      "maxLength": 500
    },
    "final_filename": {
      "type": "string",
      "maxLength": 200
    },
    "mime_type": {
      "type": "string"
    },
    "size_bytes": {
      "type": "integer",
      "minimum": 0
    },
    "content_hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "moved_at": {
      "$ref": "https://jarvis.local/schemas/common.schema.json#/$defs/timestamp_utc"
    },
    "provider_status": {
      "type": "integer"
    }
  },
  "required": [
    "file_external_id",
    "final_path",
    "final_filename",
    "mime_type",
    "moved_at",
    "provider_status"
  ],
  "additionalProperties": false
}
