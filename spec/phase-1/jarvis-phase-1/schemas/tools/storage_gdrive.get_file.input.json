{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jarvis.local/schemas/tools/storage_gdrive.get_file.input.json",
  "title": "Eingabe: Datei lesen",
  "description": "Liest eine Originaldatei und ihre Metadaten aus dem kontextbezogenen Speicher. Version 1.0.0, Phase 1.",
  "type": "object",
  "properties": {
    "context_id": {
      "$ref": "https://jarvis.local/schemas/common.schema.json#/$defs/context_id"
    },
    "adapter_id": {
      "type": "string"
    },
    "file_external_id": {
      "type": "string",
      "minLength": 1,
      "description": "Stabile Datei-ID im Speichersystem."
    },
    "include_content": {
      "type": "boolean",
      "default": true,
      "description": "false liefert nur Metadaten, z. B. fuer einen Readback."
    },
    "max_size_mb": {
      "type": "integer",
      "minimum": 1,
      "maximum": 200
    }
  },
  "required": [
    "context_id",
    "adapter_id",
    "file_external_id"
  ],
  "additionalProperties": false
}
