{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jarvis.local/schemas/tools/report_internal.write_daily_report.input.json",
  "title": "Eingabe: Tagesbericht schreiben",
  "description": "Erzeugt die abgeleitete Tagesuebersicht. Der Bericht ist niemals fuehrend; seine Erzeugung veraendert keinen Aufgabenbestand. Version 1.0.0, Phase 1.",
  "type": "object",
  "properties": {
    "context_id": {
      "$ref": "https://jarvis.local/schemas/common.schema.json#/$defs/context_id"
    },
    "adapter_id": {
      "type": "string"
    },
    "report_date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "sections": {
      "type": "object",
      "description": "Zaehlungen und Verweise je Abschnitt. Enthaelt IDs und kurze Bezeichnungen, keine Dokumentinhalte.",
      "properties": {
        "new_tasks": {
          "$ref": "#/$defs/entry_list"
        },
        "due_today": {
          "$ref": "#/$defs/entry_list"
        },
        "overdue": {
          "$ref": "#/$defs/entry_list"
        },
        "upcoming_deadlines": {
          "$ref": "#/$defs/entry_list"
        },
        "pending_approvals": {
          "$ref": "#/$defs/entry_list"
        },
        "failed_actions": {
          "$ref": "#/$defs/entry_list"
        },
        "documents_in_review": {
          "$ref": "#/$defs/entry_list"
        },
        "documents_unassigned": {
          "$ref": "#/$defs/entry_list"
        },
        "completed_yesterday": {
          "$ref": "#/$defs/entry_list"
        }
      },
      "required": [
        "new_tasks",
        "due_today",
        "overdue",
        "upcoming_deadlines",
        "pending_approvals",
        "failed_actions",
        "documents_in_review",
        "documents_unassigned",
        "completed_yesterday"
      ],
      "additionalProperties": false
    },
    "generated_at": {
      "$ref": "https://jarvis.local/schemas/common.schema.json#/$defs/timestamp_utc"
    }
  },
  "required": [
    "context_id",
    "adapter_id",
    "report_date",
    "sections",
    "generated_at"
  ],
  "additionalProperties": false,
  "$defs": {
    "entry_list": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "properties": {
          "object_id": {
            "type": "string"
          },
          "label_de": {
            "type": "string",
            "maxLength": 200
          },
          "due_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "priority": {
            "$ref": "https://jarvis.local/schemas/common.schema.json#/$defs/priority"
          }
        },
        "required": [
          "object_id",
          "label_de"
        ],
        "additionalProperties": false
      }
    }
  }
}
