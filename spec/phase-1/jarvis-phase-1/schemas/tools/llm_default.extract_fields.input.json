{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jarvis.local/schemas/tools/llm_default.extract_fields.input.json",
  "title": "Eingabe: Felder auslesen",
  "description": "Uebergibt Volltext, Erfassungskandidaten und den anzuwendenden Feldkatalog. Version 1.0.0, Phase 1.",
  "type": "object",
  "properties": {
    "context_id": {
      "$ref": "https://jarvis.local/schemas/common.schema.json#/$defs/context_id"
    },
    "document_id": {
      "type": "string",
      "pattern": "^doc_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "model_ref": {
      "type": "string",
      "description": "Verweis auf den Konfigurationseintrag, kein Modellname."
    },
    "prompt_version": {
      "type": "string"
    },
    "normalization_registry_version": {
      "$ref": "https://jarvis.local/schemas/common.schema.json#/$defs/schema_version"
    },
    "pages": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/page_text"
      },
      "minItems": 1
    },
    "form_field_candidates": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/candidate"
      },
      "default": []
    },
    "requested_fields": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/requested_field"
      },
      "description": "Pflicht- und Zusatzfelder aus dem Feldkatalog, abhaengig von der vermuteten Dokumentart."
    },
    "allowed_normalization_rules": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    }
  },
  "required": [
    "context_id",
    "document_id",
    "model_ref",
    "prompt_version",
    "normalization_registry_version",
    "pages",
    "requested_fields",
    "allowed_normalization_rules"
  ],
  "additionalProperties": false,
  "$defs": {
    "page_text": {
      "type": "object",
      "properties": {
        "page": {
          "type": "integer",
          "minimum": 1
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "page",
        "text"
      ],
      "additionalProperties": false
    },
    "candidate": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string"
        },
        "value": {
          "type": "string"
        },
        "page": {
          "type": "integer",
          "minimum": 1
        },
        "confidence": {
          "$ref": "https://jarvis.local/schemas/common.schema.json#/$defs/confidence"
        }
      },
      "required": [
        "key",
        "value",
        "page"
      ],
      "additionalProperties": false
    },
    "requested_field": {
      "type": "object",
      "properties": {
        "field_key": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{2,63}$"
        },
        "data_type": {
          "type": "string",
          "enum": [
            "string",
            "date",
            "datetime",
            "decimal",
            "integer",
            "boolean",
            "currency_code",
            "identifier"
          ]
        },
        "mandatory": {
          "type": "boolean"
        },
        "actionable": {
          "type": "boolean",
          "description": "Fliesst in Aufgaben, Fristen, Berechnungen oder Zuordnungen ein."
        },
        "hint_de": {
          "type": "string",
          "maxLength": 300
        }
      },
      "required": [
        "field_key",
        "data_type",
        "mandatory",
        "actionable"
      ],
      "additionalProperties": false
    }
  }
}
