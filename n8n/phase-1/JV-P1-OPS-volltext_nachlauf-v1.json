    {
      "id": "fca06915-4868-4ea0-95a7-5ae17eee8116",
      "name": "Eingabe bilden",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        896,
        192
      ],
      "parameters": {
        "jsCode": "// CR-12 Nachlauf: Original als base64 an den Unterworkflow; fehlt die Datei, wird der Ladefehler mitgegeben und dort als Fehlversuch protokolliert.\nconst z = $('Stapel').first().json;\nconst it = $input.first();\nlet b64 = '';\nlet ladefehler = null;\nif (it && it.binary && it.binary.data) {\n  const buf = await this.helpers.getBinaryDataBuffer(0, 'data');\n  b64 = buf.toString('base64');\n} else {\n  const e = (it && it.json && it.json.error) || null;\n  ladefehler = e ? String(e.description || e.message || 'unbekannt').slice(0, 200) : 'keine Datei geliefert';\n}\nreturn [{ json: { document_id: z.document_id, mime_type: z.mime_type, content_b64: b64, ladefehler: ladefehler, quelle: 'nachlauf' } }];\n"
      }
    },
