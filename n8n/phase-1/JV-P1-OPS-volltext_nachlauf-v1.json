    {
      "id": "5bb47585-2a26-40ef-ab96-40b4c429cd74",
      "name": "Offene lesen",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        224,
        192
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "-- CR-12 E2/E3: Dokumente ohne Volltext (hoechstens 3 Fehlversuche je Dokument), aelteste zuerst, 25 je Lauf.\nSELECT d.document_id, d.mime_type, d.source_external_id AS file_id\nFROM jarvis_privat.document d\nWHERE d.context_id = 'privat' AND d.status NOT IN ('discarded', 'misrouted')\n  AND d.source_external_id IS NOT NULL\n  AND d.mime_type IN ('application/pdf', 'image/jpeg', 'image/png', 'image/tiff')\n  AND coalesce(d.size_bytes, 0) <= 20971520\n  AND NOT EXISTS (SELECT 1 FROM jarvis_privat.document_text t WHERE t.document_id = d.document_id)\n  AND (SELECT count(*) FROM jarvis_privat.action_log l WHERE l.entry_kind = 'document_text_failed' AND l.body->>'document_id' = d.document_id) < 3\nORDER BY d.received_at\nLIMIT 25",
        "options": {}
      },
      "credentials": {
        "postgres": {
          "id": "oCkj27EiMe96vXvU",
          "name": "jv_privat_postgres"
        }
      }
    },
    {
      "id": "32073c76-746e-4399-b2cb-00d90e01bdca",
      "name": "Bericht",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        672,
        0
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT count(*)::int AS dokumente, count(t.document_id)::int AS mit_volltext, (count(*) - count(t.document_id))::int AS ohne_volltext,\n  (SELECT count(*) FROM jarvis_privat.action_log l WHERE l.entry_kind = 'document_text_failed' AND l.logged_at > now() - interval '1 day')::int AS fehlversuche_24h\nFROM jarvis_privat.document d LEFT JOIN jarvis_privat.document_text t ON t.document_id = d.document_id\nWHERE d.context_id = 'privat' AND d.status NOT IN ('discarded', 'misrouted')",
        "options": {}
      },
      "executeOnce": true,
      "credentials": {
        "postgres": {
          "id": "oCkj27EiMe96vXvU",
          "name": "jv_privat_postgres"
        }
      }
    },
