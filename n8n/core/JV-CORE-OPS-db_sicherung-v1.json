    {
      "id": "fc7721dc-c4ea-41a5-bc87-798313e95d39",
      "name": "Datei bilden A",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2240,
        192
      ],
      "parameters": {
        "jsCode": "// CR-19/TS-13: Sicherungsdatei bilden (alle Tabellen als JSON, Zeilenzahlen für den Nachweis).\nconst z = $('Ordner merken A').first().json;\nconst ex = $('Export lesen A').first().json;\nconst schemas = [ex.fach, ex.betrieb].filter(function (x) { return x && typeof x === 'object'; });\nif (!schemas.length) throw new Error('Sicherung: Export leer');\nconst zeilen = {};\nlet gesamt = 0;\nschemas.forEach(function (x) { const zz = x.zeilen || {}; Object.keys(zz).forEach(function (t) { zeilen[x.schema + '.' + t] = Number(zz[t]) || 0; gesamt += Number(zz[t]) || 0; }); });\nconst inhalt = JSON.stringify({ format: 'jarvis-sicherung-1', kontext: z.kontext, woche: z.woche, erstellt: new Date().toISOString(), schemas: schemas });\nconst bin = await this.helpers.prepareBinaryData(Buffer.from(inhalt, 'utf8'), z.dateiname, 'application/json');\nreturn [{ json: Object.assign({}, z, { zeilen: zeilen, zeilen_gesamt: gesamt, bytes_roh: Buffer.byteLength(inhalt, 'utf8') }), binary: { data: bin } }];\n"
      }
    },
