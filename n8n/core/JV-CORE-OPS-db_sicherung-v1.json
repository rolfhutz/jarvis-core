      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        96
      ],
      "parameters": {
        "jsCode": "// CR-19/TS-13: Ziel bestimmen. Kontext kommt aus der Datenbank, Wurzelordner aus der n8n-Variable (env-Verweis).\nconst e = $('Export lesen A').first().json || {};\nconst lauf = $('Lauf vorbereiten').first().json;\nconst m = /^env:([A-Z][A-Z0-9_]{3,63})$/.exec(String(e.context_root_ref || ''));\nlet root = '';\nif (m) { try { root = String($vars[m[1]] || '').trim(); } catch (x) { root = ''; } }\nif (!/^[A-Za-z0-9_-]{10,200}$/.test(root)) throw new Error('Sicherung: Wurzelordner des Kontexts ist nicht konfiguriert');\nconst k = String(e.context_id || '');\nif (!/^[a-z][a-z_]{2,40}$/.test(k)) throw new Error('Sicherung: Kontext unbekannt');\nreturn [{ json: { kontext: k, root_id: root, woche: lauf.woche, dateiname: 'JARVIS_Sicherung_' + k + '_' + lauf.woche + '.json' } }];\n"
      }
