        "query": "INSERT INTO jarvis_privat.action_log (entry_kind, actor, summary_de, body)\nVALUES ('backup_skipped', 'jarvis', 'Sicherung ' || $1 || ' bereits vorhanden, nicht erneut abgelegt',\n  jsonb_build_object('woche', $1, 'datei', $2, 'change_request', 'CR-19', 'schuld', 'TS-13'))\nRETURNING log_id"
