      "parameters": {
        "jsCode": "// CR-19/TS-13: Nachweis. Hochgeladene Datei wurde aus Drive zurückgelesen und entpackt; Grösse und Zeilenzahl je Tabelle müssen übereinstimmen.\nconst z = $('Datei bilden B').first().json;\nconst up = $('Hochladen B').first().json || {};\nconst it = $input.first();\nlet ok = false;\nlet fehler = null;\ntry {\n  if (!up.id) throw new Error('Upload ohne Datei-ID' + (up.error ? ': ' + String(up.error.message || up.error).slice(0, 200) : ''));\n  const keys = Object.keys((it && it.binary) || {});\n  if (!keys.length) throw new Error('Nachlesen lieferte keine Datei');\n  const buf = await this.helpers.getBinaryDataBuffer(0, keys[0]);\n  if (buf.length !== z.bytes_roh) throw new Error('Grösse weicht ab (' + buf.length + ' statt ' + z.bytes_roh + ')');\n  const d = JSON.parse(buf.toString('utf8'));\n  const gelesen = {};\n  (d.schemas || []).forEach(function (x) { Object.keys(x.tabellen || {}).forEach(function (t) { gelesen[x.schema + '.' + t] = Array.isArray(x.tabellen[t]) ? x.tabellen[t].length : -1; }); });\n  const abw = Object.keys(z.zeilen).filter(function (k) { return gelesen[k] !== z.zeilen[k]; });\n  if (abw.length) throw new Error('Zeilenzahl weicht ab: ' + abw.slice(0, 5).join(', '));\n  ok = true;\n} catch (e) { fehler = String(e.message || e).slice(0, 300); }\nconst body = { woche: z.woche, datei: z.dateiname + '.gz', file_id: up.id || null, tabellen: Object.keys(z.zeilen).length, zeilen: z.zeilen_gesamt,\n  bytes_roh: z.bytes_roh, nachweis: ok ? 'nachgelesen_entpackt_gezaehlt' : null, fehler: fehler, change_request: 'CR-19', schuld: 'TS-13' };\nreturn [{ json: { ok: ok, ordner_id: z.ordner_id, p64: Buffer.from(JSON.stringify(body), 'utf8').toString('base64') } }];\n"
