    {
      "parameters": {
        "jsCode": "// Vertragstor vor jedem Werkzeugaufruf. Einzige Quelle: jarvis_ops.tool_registry.\nconst RANG = { A: 1, B: 2, C: 3 };\nconst e = $('Eingabe pruefen').first().json;\nconst r = $input.first().json;\nlet code = \"allowed\";\nlet grund = \"\";\nif (r.found !== true && Number(r.versions_known) === 0) {\n  code = \"tool_not_registered\"; grund = \"Werkzeug nicht im Register: \" + e.tool_id;\n} else if (r.found !== true) {\n  code = \"tool_version_mismatch\"; grund = \"Version \" + e.tool_version + \" von \" + e.tool_id + \" ist nicht registriert\";\n} else if (r.tool_status === \"deprecated\") {\n  code = \"tool_deprecated\"; grund = \"Werkzeugversion ist ausser Betrieb\";\n} else if (r.context_allowed !== true) {\n  code = \"context_not_allowed\"; grund = \"Werkzeug ist fuer Kontext \" + e.context_id + \" nicht zugelassen\";\n} else if (!RANG[e.risk_class]) {\n  code = \"risk_class_missing\"; grund = \"risk_class fehlt oder ist unzulaessig\";\n} else if (RANG[e.risk_class] < RANG[r.registry_class]) {\n  code = \"risk_class_downgrade\"; grund = \"Aktion traegt Klasse \" + e.risk_class + \", Register verlangt mindestens \" + r.registry_class;\n} else if (e.risk_class === \"C\" && (!e.approval_id || e.approval_status !== \"approved\")) {\n  code = \"approval_missing\"; grund = \"Klasse C ohne gueltige Freigabe\";\n} else if (r.tool_status !== \"approved\") {\n  code = \"tool_not_released\"; grund = \"Werkzeug steht auf \" + r.tool_status + \". Freigabe erst nach praktischem Nachweis.\";\n} else if (!e.action_id) {\n  code = \"action_id_missing\"; grund = \"Werkzeugaufruf ohne action_id ist unzulaessig\";\n}\nconst ok = code === \"allowed\";\nreturn [{ json: {\n  invocation_allowed: ok,\n  gate_code: code,\n  reason: grund,\n  tool_id: e.tool_id,\n  tool_version: e.tool_version,\n  tool_status: r.tool_status || null,\n  adapter_id: r.found === true ? r.adapter_id : null,\n  action_id: e.action_id,\n  dry_run: e.dry_run,\n  payload: e.payload,\n  registry_class: r.registry_class || null,\n  readback_supported: r.found === true ? r.readback_supported : null,\n  accepted_methods: r.found === true ? r.accepted_methods : null,\n  evidence_limitation: r.found === true ? r.evidence_limitation : null,\n  risk_class: e.risk_class || null,\n  context_id: e.context_id,\n  trace_id: e.trace_id\n} }];"
      },
