    {
      "parameters": {
        "jsCode": "// Fuehrt Vertragstor und Adapterergebnis zusammen. Der Nachweis erfolgt getrennt ueber evidence_verify (D8).\n// Ein Adapterfehler steht in adapter_error; das Feld error bleibt n8n-Laufzeitfehlern vorbehalten.\nconst t = $('Vertragstor pruefen').first().json;\nconst a = $input.first().json;\nreturn [{ json: {\n  invocation_allowed: true,\n  gate_code: 'allowed',\n  reason: '',\n  tool_id: t.tool_id,\n  tool_version: t.tool_version,\n  adapter_id: t.adapter_id,\n  context_id: t.context_id,\n  action_id: t.action_id,\n  risk_class: t.risk_class,\n  readback_supported: t.readback_supported,\n  accepted_methods: t.accepted_methods,\n  dry_run: t.dry_run,\n  status: a.status || 'error',\n  write_outcome: a.write_outcome || 'unknown',\n  target_object_ref: a.target_object_ref || null,\n  verification_method: a.verification_method || null,\n  observed: a.observed || null,\n  expected: a.expected || null,\n  case_number: a.case_number || null,\n  existing_document_id: a.existing_document_id || null,\n  adapter_error: a.error || null,\n  invoked_at: new Date().toISOString(),\n  trace_id: t.trace_id\n} }];"
      },
