    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT (r.tool_id IS NOT NULL) AS found, r.status AS tool_status, r.adapter_id, r.risk_class_default::text AS registry_class, coalesce($3 = ANY (r.allowed_contexts), false) AS context_allowed, r.readback_supported, r.accepted_methods, r.evidence_limitation, (SELECT count(*) FROM jarvis_ops.tool_registry x WHERE x.tool_id = $1)::int AS versions_known FROM (SELECT 1) AS eins LEFT JOIN jarvis_ops.tool_registry r ON r.tool_id = $1 AND r.version = $2",
        "options": {
          "queryReplacement": "={{ $json.tool_id }},{{ $json.tool_version }},{{ $json.context_id }}"
        }
      },
