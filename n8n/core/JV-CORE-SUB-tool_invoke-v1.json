    {
      "parameters": {
        "jsCode": "const alle = $input.all();\nif (alle.length !== 1) {\n  throw new Error(\"tool_invoke_invalid_input: genau ein Aufruf je Ausfuehrung erwartet, erhalten \" + alle.length);\n}\nconst e = alle[0].json;\nif (!/^[a-z][a-z0-9_]{2,63}$/.test(String(e.context_id || \"\"))) {\n  throw new Error(\"tool_invoke_invalid_input: context_id fehlt oder hat kein gueltiges Format\");\n}\nif (!/^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$/.test(String(e.tool_id || \"\"))) {\n  throw new Error(\"tool_invoke_invalid_input: tool_id fehlt oder ist ungueltig\");\n}\nif (!/^[0-9]+\\.[0-9]+\\.[0-9]+$/.test(String(e.tool_version || \"\"))) {\n  throw new Error(\"tool_invoke_invalid_input: tool_version fehlt oder ist ungueltig\");\n}\nif (e.action_id !== undefined && e.action_id !== null && e.action_id !== '' && !/^act_[A-Za-z0-9_]{6,64}$/.test(String(e.action_id))) {\n  throw new Error(\"tool_invoke_invalid_input: action_id ist ungueltig\");\n}\nreturn [{ json: {\n  context_id: e.context_id,\n  tool_id: e.tool_id,\n  tool_version: e.tool_version,\n  risk_class: e.risk_class || \"\",\n  approval_id: e.approval_id || null,\n  approval_status: e.approval_status || null,\n  payload: e.payload || {},\n  action_id: e.action_id || null,\n  dry_run: e.dry_run === true,\n  trace_id: e.trace_id || null\n} }];"
      },
